        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseJson = pm.response.json();",
                  "const token = responseJson.accessToken || (responseJson.data && responseJson.data.accessToken);",
                  "if (token) {",
                  "    pm.environment.set(\"adminToken\", token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sparq.com\",\n  \"password\": \"AdminSecurePassword123\"\n}"
            },
